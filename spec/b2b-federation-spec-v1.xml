  <bay:components>
    <b2b:business-service-contract id="comp.order-to-cash-v1" key="order-to-cash-v1" name="Order-to-Cash v1 Contract Pack" status="accepted" revision="2" source-pointer="github.com/b2bautopilot/xx-federation-contracts">
      <bay:description>7-stage cryptographic business transaction pack (RFQ -> Quote -> PO -> Confirm -> Ship -> Invoice -> Payment).</bay:description>
      <b2b:protocol-pack>builders.federation.order_to_cash.v1</b2b:protocol-pack>
      <b2b:signature-algorithm>Ed25519</b2b:signature-algorithm>
      <b2b:lifecycle-stages>rfq,quote,purchase_order,order_confirmation,shipment_notice,invoice,payment_settlement</b2b:lifecycle-stages>
    </b2b:business-service-contract>

    <b2b:userspace-wireguard-mesh id="comp.x-mesh" key="x-mesh" name="x-mesh WireGuard Substrate" status="accepted" revision="3" source-pointer="github.com/b2bautopilot/xx-mesh-net">
      <bay:description>Standalone WireGuard mesh daemon supporting kernel WireGuard on Linux, WireGuardNT on Windows, and wireguard-go on macOS/iOS with UDS control socket.</bay:description>
      <b2b:userspace-engine>wireguard-go</b2b:userspace-engine>
      <b2b:socket-path>/run/x-mesh/sock</b2b:socket-path>
      <b2b:gossip-ttl-seconds>30</b2b:gossip-ttl-seconds>
      <b2b:supported-engines>kernel_wireguard,wireguard_nt,wireguard_go</b2b:supported-engines>
      <b2b:gossip-port>8442</b2b:gossip-port>
      <b2b:fabric-port>4001</b2b:fabric-port>
    </b2b:userspace-wireguard-mesh>

    <b2b:payload-blind-relay id="comp.federation-relay" key="federation-relay" name="Payload-Blind Relay Cells" status="accepted" revision="2" source-pointer="github.com/b2bautopilot/xx-federation-relay">
      <bay:description>GCP, AWS, and Azure standing relay cells with 12h/64GiB circuit budgets.</bay:description>
      <b2b:circuit-protocol>libp2p/circuit-relay-v2</b2b:circuit-protocol>
      <b2b:max-connection-duration-hours>12</b2b:max-connection-duration-hours>
      <b2b:max-connection-bandwidth-gib>64</b2b:max-connection-bandwidth-gib>
      <b2b:payload-blind>true</b2b:payload-blind>
    </b2b:payload-blind-relay>

    <b2b:enterprise-airlock-gateway id="comp.federation-gateway" key="federation-gateway" name="Enterprise Gateway Airlock" status="accepted" revision="2" source-pointer="github.com/b2bautopilot/xx-federation-gateway">
      <bay:description>Outbound-only gateway edge with zero open inbound public listeners and SPIFFE cert pinning.</bay:description>
      <b2b:inbound-public-listeners>false</b2b:inbound-public-listeners>
      <b2b:spiffe-trust-domain>builders-net</b2b:spiffe-trust-domain>
      <b2b:outbound-only>true</b2b:outbound-only>
    </b2b:enterprise-airlock-gateway>

    <b2b:sovereign-control-plane id="comp.builders-control" key="builders-control" name="Sovereign Control Plane" status="accepted" revision="2" source-pointer="github.com/b2bautopilot/xx-builders-net">
      <bay:description>Sole owner of Postgres storage with 57 migrations and fail-closed schema checks.</bay:description>
      <b2b:grpc-endpoint>127.0.0.1:9090</b2b:grpc-endpoint>
      <b2b:http-endpoint>127.0.0.1:8080</b2b:http-endpoint>
      <b2b:postgres-migrations-count>57</b2b:postgres-migrations-count>
      <b2b:advisory-lock-hex>0x6232626d69677261</b2b:advisory-lock-hex>
    </b2b:sovereign-control-plane>

    <b2b:sandboxed-agent-runtime id="comp.builders-agent" key="builders-agent" name="Workstation Agent Runtime" status="accepted" revision="2" source-pointer="github.com/b2bautopilot/xx-builders-agent">
      <bay:description>Containerized agent supervisor serving 16 coordination_* MCP tools on rootless podman overlay.</bay:description>
      <b2b:mcp-socket-port>9210</b2b:mcp-socket-port>
      <b2b:supported-sandboxes>podman,apple_container,wsl2_containerd,gvisor</b2b:supported-sandboxes>
      <b2b:graph-driver-required>overlay</b2b:graph-driver-required>
      <b2b:metadata-endpoints-denied>true</b2b:metadata-endpoints-denied>
    </b2b:sandboxed-agent-runtime>

    <b2b:admin-portal id="comp.builders-portal" key="builders-portal" name="Builders Admin Portal" status="accepted" revision="2" source-pointer="github.com/b2bautopilot/xx-builders-portal">
      <bay:description>Next.js 16 pure gRPC admin portal with zero direct SQL.</bay:description>
      <b2b:framework>Next.js 16 / React 19</b2b:framework>
      <b2b:direct-sql-permitted>false</b2b:direct-sql-permitted>
      <b2b:grpc-client-mode>pure-grpc-9090</b2b:grpc-client-mode>
    </b2b:admin-portal>

    <b2b:operator-cockpit id="comp.builders-hub" key="builders-hub" name="Builders Hub Operator Cockpit" status="accepted" revision="2" source-pointer="github.com/b2bautopilot/xx-builders-hub">
      <bay:description>Flutter multi-platform non-authoritative operator cockpit.</bay:description>
      <b2b:framework>Flutter 3.41.4</b2b:framework>
      <b2b:authoritative>false</b2b:authoritative>
    </b2b:operator-cockpit>

    <b2b:simulation-infrastructure id="comp.sim-infra" key="sim-infra" name="Simulation Infrastructure" status="accepted" revision="2" source-pointer="github.com/b2bautopilot/xx-sim-infra">
      <bay:description>OpenTofu GCP/AWS/Azure disposable orgs and standing relay cells.</bay:description>
      <b2b:orchestrator>OpenTofu</b2b:orchestrator>
      <b2b:supported-clouds>gcp,aws,azure</b2b:supported-clouds>
      <b2b:contract-spec>CONTRACT.md</b2b:contract-spec>
    </b2b:simulation-infrastructure>
  </bay:components>

